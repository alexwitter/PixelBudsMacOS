<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox with Bluetooth as the only capability. macOS enforces
         this: no network, no files outside the app's own container. This
         fork has no auto-updater and talks only to the buds over Bluetooth,
         so anything else would be a red flag in a future change. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.device.bluetooth</key>
    <true/>
</dict>
</plist>
